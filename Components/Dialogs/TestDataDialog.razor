<div class="howto">
    <p class="data-intro">Add test geometry to the current project on the active layer. Existing drawing data is kept. Use Undo once to remove the generated batch.</p>
    @foreach (var section in _sections)
    {
        <section class="howto-item @(section.Open ? "open" : "")">
            <button type="button" class="howto-head" aria-expanded="@section.Open.ToString().ToLowerInvariant()" @onclick="() => section.Open = !section.Open">
                <span class="chevron @(section.Open ? "open" : "")"></span>
                <span class="howto-title">@section.Title debug</span>
            </button>
            <div class="accordion-body @(section.Open ? "open" : "")">
                <div class="howto-content settings">
                    <label class="setting-row">
                        <span>Number of @section.Label</span>
                        <input class="text-input" type="number" min="1" max="10000" step="1" @bind="section.Count" disabled="@_busy" />
                    </label>
                    <label class="test-spacing">
                        <span>Spacing: @section.Spacing px</span>
                        <input type="range" min="0" max="200" step="1" @bind="section.Spacing" @bind:event="oninput" disabled="@_busy" />
                    </label>
                    <p class="data-intro">@section.Description Spacing controls the approximate distance between successive item centres at the current zoom, not a guaranteed minimum gap. Items reflect back inside a 48 px viewport border.</p>
                    @if (section.Error is not null)
                    {
                        <p class="test-error" role="alert">@section.Error</p>
                    }
                    @if (section.Result is not null)
                    {
                        <p role="status">@section.Result</p>
                    }
                    <div class="settings-actions">
                        <button type="button" class="chip active" disabled="@_busy" @onclick="() => Generate(section)">Add @section.Label</button>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@code {
    public sealed record TestDataOptions(string Kind, int Count, double Spacing);

    [Parameter] public EventCallback<TestDataOptions> OnGenerate { get; set; }

    private sealed class TestSection(string kind, string title, string label, string description)
    {
        public string Kind { get; } = kind;
        public string Title { get; } = title;
        public string Label { get; } = label;
        public string Description { get; } = description;
        public bool Open { get; set; } = kind == "line";
        public int Count { get; set; } = 100;
        public double Spacing { get; set; } = 24;
        public string? Error { get; set; }
        public string? Result { get; set; }
    }

    private readonly TestSection[] _sections =
    [
        new("line", "Line", "lines", "Separate lines with random lengths and directions."),
        new("circle", "Circle", "circles", "Circles with random radii."),
        new("rectangle", "Rectangle", "rectangles", "Rectangles with random sizes."),
        new("text", "Text", "text items", "Numbered labels with varied sizes, families, bold, italic and underline."),
        new("point", "Point", "points", "Single-point markers with fixed screen size, using the global marker settings."),
        new("measurement", "Measurement", "measurements", "Alternating triangular areas and two-point CAD dimensions, with lengths, angles and area enabled.")
    ];
    private bool _busy;

    private async Task Generate(TestSection section)
    {
        if (_busy) return;
        section.Error = null;
        section.Result = null;
        if (section.Count is < 1 or > 10000 || !double.IsFinite(section.Spacing) || section.Spacing is < 0 or > 200)
        {
            section.Error = "Enter 1 to 10,000 items and spacing from 0 to 200 px.";
            return;
        }

        _busy = true;
        try
        {
            await OnGenerate.InvokeAsync(new(section.Kind, section.Count, section.Spacing));
            section.Result = $"Added {section.Count:N0} {section.Label}. Use Undo to remove this batch.";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            section.Error = $"Could not add test {section.Label}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
