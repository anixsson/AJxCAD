<div class="settings app-settings">
    <p class="data-intro">These settings belong to the app. Appearance, UI scale, text size, zoom range and grid color are kept on this computer; developer tools reset at launch. Project settings are in File → Project settings.</p>

    <h3>Appearance</h3>
    <div class="mode-options">
        <button type="button" class="mode-card @(Appearance == "full" ? "active" : "")" aria-pressed="@((Appearance == "full").ToString().ToLowerInvariant())" @onclick='() => AppearanceChanged.InvokeAsync("full")'>
            <strong>Full effects</strong>
            <span>Frosted glass, glows and animations.</span>
        </button>
        <button type="button" class="mode-card @(Appearance == "performance" ? "active" : "")" aria-pressed="@((Appearance == "performance").ToString().ToLowerInvariant())" @onclick='() => AppearanceChanged.InvokeAsync("performance")'>
            <strong>Performance</strong>
            <span>No blur, glow or animation. Solid panels, fastest drawing.</span>
        </button>
        <button type="button" class="mode-card @(Appearance == "paper" ? "active" : "")" aria-pressed="@((Appearance == "paper").ToString().ToLowerInvariant())" @onclick='() => AppearanceChanged.InvokeAsync("paper")'>
            <strong>Paper</strong>
            <span>White paper, black ink and monochrome controls. No glows or blur.</span>
        </button>
    </div>
    <h3>Interface size</h3>
    <div class="setting-row setting-scale" role="group" aria-label="UI scale">
        <span>UI scale</span>
        <button type="button" class="chip" aria-label="Decrease UI scale by 10%" disabled="@(UiScalePercent <= 80)"
                @onclick="() => UiScalePercentChanged.InvokeAsync(UiScalePercent - 10)">−</button>
        <output aria-live="polite">@UiScalePercent%</output>
        <button type="button" class="chip" aria-label="Increase UI scale by 10%" disabled="@(UiScalePercent >= 140)"
                @onclick="() => UiScalePercentChanged.InvokeAsync(UiScalePercent + 10)">+</button>
    </div>
    <p class="data-intro">Adjust the size of menus and controls. The drawing canvas stays the same size.</p>
    <div class="setting-row setting-scale" role="group" aria-label="Text size">
        <span>Text size</span>
        <button type="button" class="chip" aria-label="Decrease text size by 10%" disabled="@(TextScalePercent <= 100)"
                @onclick="() => TextScalePercentChanged.InvokeAsync(TextScalePercent - 10)">−</button>
        <output aria-live="polite">@TextScalePercent%</output>
        <button type="button" class="chip" aria-label="Increase text size by 10%" disabled="@(TextScalePercent >= 160)"
                @onclick="() => TextScalePercentChanged.InvokeAsync(TextScalePercent + 10)">+</button>
    </div>
    <p class="data-intro">Enlarge interface text independently of UI scale. Drawing text, measurements and print output are unchanged.</p>
    <h3>Zoom and scale</h3>
    <label class="setting-row setting-check">
        <input type="checkbox" checked="@ExtendedZoom" @onchange="e => ExtendedZoomChanged.InvokeAsync(e.Value is true)" />
        <span class="setting-checkmark" aria-hidden="true"></span>
        <span>Extended zoom range</span>
    </label>
    <p class="data-intro">Current limits: @(ExtendedZoom ? "1:10000 zoom-out to 1000:1 zoom-in" : "1:1000 zoom-out to 100:1 zoom-in"). Turning this off brings the current view back within the normal limits. Drawing sizes and print page scales are unchanged.</p>
    <h3>Grid color</h3>
    <label class="setting-row">
        <span>Minor and major grid lines</span>
        <input type="color" aria-label="Grid color" value="@(GridColor ?? (Appearance == "paper" ? "#000000" : "#a98cff"))"
               @onchange="e => GridColorChanged.InvokeAsync(e.Value?.ToString())" />
    </label>
    <div class="settings-actions">
        <button type="button" class="chip" disabled="@(GridColor is null)" @onclick="() => GridColorChanged.InvokeAsync((string?)null)">Use theme default</button>
    </div>
    <p class="data-intro">@(GridColor is null ? "Using the appearance theme's grid colors." : $"Custom grid color: {GridColor}.") Major lines are stronger; origin axes are unchanged. The grid is never printed or exported.</p>
    <h3>Developer tools</h3>
    <label class="setting-row setting-check">
        <input type="checkbox" @bind="ShowDebugMenu" @bind:after="UpdateDebugMenu" />
        <span class="setting-checkmark" aria-hidden="true"></span>
        <span>Show Debug menu</span>
    </label>
    <p class="data-intro">Show the debug log and test data tools. Starts enabled in debug builds and disabled in release builds.</p>
</div>

@code {
    [Parameter] public string Appearance { get; set; } = "full";
    [Parameter] public EventCallback<string> AppearanceChanged { get; set; }
    [Parameter] public bool ExtendedZoom { get; set; }
    [Parameter] public EventCallback<bool> ExtendedZoomChanged { get; set; }
    [Parameter] public string? GridColor { get; set; }
    [Parameter] public EventCallback<string?> GridColorChanged { get; set; }
    [Parameter] public int UiScalePercent { get; set; } = 100;
    [Parameter] public EventCallback<int> UiScalePercentChanged { get; set; }
    [Parameter] public int TextScalePercent { get; set; } = 100;
    [Parameter] public EventCallback<int> TextScalePercentChanged { get; set; }
    [Parameter] public bool ShowDebugMenu { get; set; }
    [Parameter] public EventCallback<bool> ShowDebugMenuChanged { get; set; }

    private Task UpdateDebugMenu() => ShowDebugMenuChanged.InvokeAsync(ShowDebugMenu);
}
