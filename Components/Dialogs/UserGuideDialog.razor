<div class="howto">
    <p class="data-intro">Your guide to drawing, editing and managing projects in AJxCAD. Expand a topic below. Keyboard shortcuts use Cmd on macOS and Ctrl on Windows.</p>
    @foreach (var s in _sections)
    {
        var open = _open == s.Title;
        <section class="howto-item @(open ? "open" : "")">
            <button type="button" class="howto-head" aria-expanded="@open.ToString().ToLowerInvariant()" @onclick="() => Toggle(s.Title)">
                <span class="chevron @(open ? "open" : "")"></span>
                <span class="howto-title">@s.Title</span>
                @if (s.Key != "")
                {
                    <kbd>@s.Key</kbd>
                }
            </button>
            <div class="accordion-body @(open ? "open" : "")">
                <div class="howto-content">
                    <p>@s.Summary</p>
                    <dl class="about-keys">
                        @foreach (var (k, d) in s.Keys)
                        {
                            <dt>@k</dt><dd>@d</dd>
                        }
                    </dl>
                </div>
            </div>
        </section>
    }
</div>

