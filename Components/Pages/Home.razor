    // Largest 1-2-5 value (x 10^n) that is <= value.
    private static double NiceAtMost(double value)
    {
        var pow = Math.Pow(10, Math.Floor(Math.Log10(value)));
        foreach (var m in new[] { 5, 2, 1 })
            if (m * pow <= value) return m * pow;
        return pow;
    }

    private static string Css(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        NativeWindow.CloseRequested -= OnNativeCloseRequested;
        FontSizeHoldStop();
        if (_cad is not null)
        {
            try
            {
                await _cad.InvokeVoidAsync("dispose");
                await _cad.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
