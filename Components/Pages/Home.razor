@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="app @(EffectiveAppearance != "full" ? "perf" : "") @(EffectiveAppearance == "paper" ? "paper" : "") @(NativeWindow.IsMac ? "mac" : "win")"
     style="--ui-scale: @Css(_uiScalePercent / 100d); --text-scale: @Css(_textScalePercent / 100d)">
<div class="workspace" @ref="_workspace">
    <canvas @ref="_canvas"></canvas>
    <div class="line-length-input" data-line-length hidden>
        <div class="line-length-row">
            <input id="line-length" type="text" inputmode="decimal" autocomplete="off" placeholder="Length"
                   aria-label="Line length in millimetres" aria-describedby="line-length-error" />
            <span aria-hidden="true">mm</span>
        </div>
        <span id="line-length-error" role="alert"></span>
    </div>
</div>

<Modal Open="@(_dialog == "settings")" Title="App settings" Width="500" OnClose="CloseDialog">
    <SettingsDialog Appearance="_appearance" AppearanceChanged="SetAppearance" ShowDebugMenu="_showDebugMenu" ShowDebugMenuChanged="SetShowDebugMenu"
                    ExtendedZoom="_extendedZoom" ExtendedZoomChanged="SetExtendedZoom" GridColor="_gridColor" GridColorChanged="SetGridColor"
                    UiScalePercent="_uiScalePercent" UiScalePercentChanged="SetUiScalePercent"
                    TextScalePercent="_textScalePercent" TextScalePercentChanged="SetTextScalePercent" />
</Modal>

<Modal Open="@(_dialog == "project")" Title="Project settings" Width="500" OnClose="CloseDialog">
    <ProjectSettingsDialog ProjectName="@_projectName" ProjectNameChanged="SetProjectName" OnShowData="ShowData"
                           PointSettings="_projectPointSettings" OnPointSettingsChanged="ChangePointSettings" PointError="@_pointSettingsError" />
</Modal>

<Modal Open="@(_dialog == "data")" Title="Data buckets" Width="600" OnClose="CloseDialog">
    <DataDialog Buckets="_buckets" LoadPage="LoadBucketPage" />
</Modal>

<Modal Open="@(_dialog == "print")" Title="Print / Export" Width="500" OnClose="CloseDialog">
    <PrintDialog Pages="@(_pages?.Pages ?? [])" Busy="_printing" Error="@_printError" Status="@_printStatus"
                 OnPrint="PrintPage" OnExport="ExportPage" ExportedPath="@_exportedPath" OnOpenLocation="OpenExportLocation" OnOpenFile="OpenExportedFile" />
</Modal>

<Modal Open="@(_dialog == "guide")" Title="AJxCAD User guide" Width="600" OnClose="CloseDialog">
    <UserGuideDialog />
</Modal>

<Modal Open="@(_dialog == "about")" Title="About AJxCAD" Glow="true" OnClose="CloseDialog">
    <AboutDialog />
</Modal>

<Modal Open="@(_dialog == "save-changes")" Title="@SaveChangesTitle" Width="500" OnClose="CloseDialog">
    <p class="data-intro">Save changes to <strong>@_projectName</strong> before @PendingActionDescription? Your unsaved changes will be lost if you don't save.</p>
    <div class="settings-actions">
        <button type="button" class="chip" disabled="@ProjectActionBusy" @onclick="CloseDialog">Cancel</button>
        <button type="button" class="chip danger" disabled="@ProjectActionBusy" @onclick="() => ContinueProjectAction(false)">Don't save</button>
        <button type="button" class="chip active default-action" data-default-action disabled="@ProjectActionBusy" @onclick="() => ContinueProjectAction(true)">
            @(_savingProject ? "Saving..." : "Save")
        </button>
    </div>
</Modal>

<Modal Open="@(_dialog == "delete-measurement")" Title="Delete measurement?" Width="500" OnClose="CloseDialog">
    <p class="data-intro">Delete this saved measurement? Other measurements and drawing lines will stay. You can undo this action.</p>
    @if (_deleteMeasurementError is not null)
    {
        <p class="test-error" role="alert">@_deleteMeasurementError</p>
    }

    <div class="settings-actions">
        <button type="button" class="chip" disabled="@_deletingMeasurement" @onclick="CloseDialog">Cancel</button>
        <button type="button" class="chip danger" disabled="@_deletingMeasurement" @onclick="ConfirmDeleteMeasurement">
            @(_deletingMeasurement ? "Deleting..." : "Delete measurement")
        </button>
    </div>
</Modal>

<Modal Open="@(_dialog == "remove-layer")" Title="Remove layer?" Width="500" OnClose="CloseLayerRemovalDialog">
    <p class="data-intro">Remove <strong>@PendingLayerRemovalName</strong>? Its items will be moved to Layer 0. You can undo this action.</p>
    @if (_layerError is not null)
    {
        <p class="test-error" role="alert">@_layerError</p>
    }
    <div class="settings-actions">
        <button type="button" class="chip" @onclick="CloseLayerRemovalDialog">Cancel</button>
        <button type="button" class="chip danger" @onclick="ConfirmRemoveLayer">Remove layer</button>
    </div>
</Modal>

<Modal Open="@(_dialog == "symbol-layers-updated")" Title="Layers updated" Width="500" OnClose="CloseDialog">
    <p class="data-intro">Layers are updated in the source of @(_symbolLayerUpdates.Length == 1 ? "a symbol" : $"{_symbolLayerUpdates.Length} symbols") with local layer choices. Do you want to use the source layers?</p>
    <ul class="data-intro symbol-source">
        @foreach (var source in _symbolLayerUpdates.Select(u => u.Source).Distinct())
        {
            <li title="@source">@Path.GetFileName(source)</li>
        }
    </ul>
    <p class="data-intro">Keep local keeps the layers chosen in this project. Closing this asks again later; the selected symbol's information box also offers the choice.</p>
    <div class="settings-actions">
        <button type="button" class="chip" disabled="@_symbolBusy" @onclick="() => ResolveSymbolLayerUpdates(false)">Keep local</button>
        <button type="button" class="chip active default-action" data-default-action disabled="@_symbolBusy"
                @onclick="() => ResolveSymbolLayerUpdates(true)">Use source layers</button>
    </div>
</Modal>

<Modal Open="@(_dialog == "open-symbol-source")" Title="Open source project?" Width="500" OnClose="CloseDialog">
    <p class="data-intro">Save this host project first to keep your changes.</p>
    <p class="data-intro symbol-source" title="@_symbolInfo?.Source">Source: @_symbolInfo?.Source</p>
    <div class="settings-actions">
        <button type="button" class="chip" disabled="@_symbolBusy" @onclick="CloseDialog">Cancel</button>
        <button type="button" class="chip" disabled="@_symbolBusy" @onclick="() => ConfirmOpenSymbolSource(false)">Open without saving</button>
        <button type="button" class="chip active default-action" data-default-action disabled="@_symbolBusy"
                @onclick="() => ConfirmOpenSymbolSource(true)">Save host and open source</button>
    </div>
</Modal>

@if (_showDebugMenu)
{
    <Modal Open="@(_dialog == "testdata")" Title="Test data" Width="560" OnClose="CloseDialog">
        <TestDataDialog OnGenerate="GenerateTestData" />
    </Modal>
}

@if (_openMenu is not null)
{
    <div class="menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault></div>
}

<div class="tool-dock">
    @foreach (var group in new[] { "general", "data" })
    {
        <aside class="glass tool-group" aria-label="@(group == "general" ? "General tools" : "Drawing tools")">
            @foreach (var t in _tools.Where(t => t.Group == group && t.Id != "page"))
            {
                <button type="button" class="tool-btn @(_tool == t.Id ? "active" : "")" aria-label="@t.Title (@t.Hotkey)" @onclick="() => SetTool(t.Id)">
                    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)t.Icon)</svg>
                    <span class="tool-tip" aria-hidden="true">@t.Title<kbd>@t.Hotkey</kbd></span>
                </button>
            }
        </aside>
    }
</div>

@if (_tool == "select")
{
    <div class="toolmenu-dock">
        @if (_moveStep is not null)
        {
            <section class="glass process-box" role="dialog" aria-label="Move selection" aria-live="polite">
                @if (_moveStep == "base")
                {
                    <div class="process-step">Move · Step 1 of 2</div>
                    <div class="process-title">@(_moveHasBase ? "Base point set" : "Pick a base point")</div>
                    <p class="process-text">
                        @(_moveHasBase
                            ? "Click again to choose a different point, or press Next."
                            : "Click a corner of the selection. Points snap to line ends and the grid.")
                    </p>
                    <div class="process-actions">
                        <button type="button" class="chip" @onclick="CancelProcess">Cancel</button>
                        <button type="button" class="chip active default-action" data-default-action disabled="@(!_moveHasBase)" @onclick="ConfirmMoveBase">Next<span class="key-hint">Space</span></button>
                    </div>
                }
                else
                {
                    <div class="process-step">Move · Step 2 of 2</div>
                    <div class="process-title">Pick the destination</div>
                    <p class="process-text">Click where the base point should go. Everything selected moves with it.</p>
                    <div class="process-actions">
                        <button type="button" class="chip" @onclick="CancelProcess">Cancel</button>
                    </div>
                }
            </section>
        }
        else if (_selectionList is { } selList)
        {
            <section class="glass process-box" role="dialog" aria-label="Selections" aria-live="polite">
                <div class="process-step">Selections · @selList.Entries.Count(e => e.Selected) of @selList.Entries.Length selected</div>
                <p class="process-text">Each selected item is labelled on the board. Uncheck an item to remove it from the selection; check it again to restore it.</p>
                <div class="stack-list measure-point-list" role="group" aria-label="Selected items">
                    @for (var i = 0; i < selList.Entries.Length; i++)
                    {
                        var index = i;
                        var entry = selList.Entries[i];
                        <button type="button" class="chip check-chip stack-end @(entry.Kind == "Measurement" ? "area-option" : "") @(entry.Selected ? "active" : "")"
                                role="checkbox" aria-checked="@(entry.Selected.ToString().ToLowerInvariant())"
                                @onclick="() => ToggleSelectionEntry(index)">
                            <span class="check-box" aria-hidden="true">@(entry.Selected ? "✓" : "")</span>
                            <span class="stack-label">@entry.Label</span>
                            <span class="stack-meta">@entry.Kind@(entry.Detail is null ? "" : $" · {entry.Detail}")</span>
                        </button>
                    }
                </div>
                <div class="process-actions">
                    <button type="button" class="chip active default-action" data-default-action @onclick="CloseSelectionList">Close<span class="key-hint">Space</span></button>
                </div>
            </section>
        }
        else if (_pointInfo is { Point: not null } pointInfo)
        {
            <PointInfoBox Info="pointInfo" OnMarkerChanged="ChangePointMarker" />
        }
        else if (_symbolInfo is not null)
        {
            <SymbolInfoBox Info="_symbolInfo" Busy="_symbolBusy" Error="@_symbolError" Warning="@_symbolWarning" OnChoose="ChooseSymbolProject"
                           OnRefresh="RefreshSymbol" OnOpenSource="OpenSymbolSource" OnScale="ChangeSymbolScale" OnClose="CloseSymbol" OnError="ShowSymbolError"
                           Recent="_symbolRecent" OnRecent="PlaceRecentSymbol" OnForgetRecent="ForgetRecentSymbol"
                           OnLayerVisible="SetSymbolLayerVisible" OnUseSourceLayers="UseSymbolSourceLayers" OnKeepLocalLayers="KeepSymbolLocalLayers" />
        }
        else if (_textInfo is not null)
        {
            @TextInfoBox
        }
        else if (_shapeInfo is { Id: not null } selectedShape)
        {
            <ShapeInfoBox @key="selectedShape.Id" Type="@selectedShape.Type" Info="selectedShape" UnitLabel="@ShapeInputUnit.Label"
                          UnitMm="ShapeInputUnit.Mm" Error="@_shapeError"
                          OnDimension="ChangeShapeDimension" OnCancel="CancelShape" OnPlace="SaveShape" />
        }
        else if (_stack is { } st)
        {
            <section class="glass process-box" role="dialog" aria-label="Selection points" aria-live="polite">
                <div class="process-step">@(st.Shared ? "Corner" : "Selection") · @st.Ends.Length points</div>
                @if (st.Shared)
                {
                    <div class="process-title">x @st.X · y @st.Y</div>
                }
                <p class="process-text">Choose the points to move. Blue options are measurement area points; other options are line ends. Unchecked points stay put.</p>
                <div class="stack-list measure-point-list" role="group" aria-label="Selected line and area points">
                    @for (var i = 0; i < st.Ends.Length; i++)
                    {
                        var index = i;
                        var end = st.Ends[i];
                        <button type="button" class="chip check-chip stack-end @(end.Area ? "area-option" : "") @(end.Selected ? "active" : "")"
                                role="checkbox" aria-checked="@(end.Selected.ToString().ToLowerInvariant())"
                                @onclick="() => ToggleStackEnd(index)">
                            <span class="check-box" aria-hidden="true">@(end.Selected ? "✓" : "")</span>
                            <span class="stack-label">@end.Label</span>
                            <span class="stack-meta">@(end.Area ? end.To : end.Length is null ? "line end" : $"{end.Length} → {end.To}")</span>
                        </button>
                    }
                </div>
            </section>
        }
        @if (_selectedMeasurement is { } selectedMeasure && _moveStep is null)
        {
            <section class="glass process-box" aria-label="Selected measurement" aria-live="polite">
                <div class="process-step">Measurement · @selectedMeasure.Points points</div>
                <button type="button" class="chip" title="Edit this saved measurement"
                        @onclick="() => EditMeasurement(selectedMeasure.Id)">Length @selectedMeasure.Length</button>
                @if (selectedMeasure.Area is not null)
                {
                    <p class="process-text">Area @selectedMeasure.Area</p>
                }
                <p class="process-text">Drag selected blue points to move them. Click the length above or a label on the board to edit saved options.</p>
            </section>
        }
        <div class="toolmenu-row">
            <aside class="glass toolmenu" aria-label="Select toolmenu">
                <span class="toolmenu-label">Select</span>
                <div class="unit-row" role="group" aria-label="Selection mode">
                    @foreach (var mode in new[] { "nodes", "lines" })
                    {
                        <button type="button" class="chip @(_selectionMode == mode ? "active" : "")"
                                aria-pressed="@((_selectionMode == mode).ToString().ToLowerInvariant())"
                                @onclick="() => SetSelectionMode(mode)">@(mode == "nodes" ? "Nodes" : "Lines")</button>
                    }
                    @if (_selectionCount > 0)
                    {
                        <span class="toolmenu-divider" role="separator" aria-orientation="vertical"></span>
                        <button type="button" class="chip @(_selectionList is not null ? "active" : "")"
                                title="List and label every selected item; uncheck items to deselect them"
                                aria-pressed="@((_selectionList is not null).ToString().ToLowerInvariant())"
                                disabled="@(_moveStep is not null)" @onclick="ToggleSelectionList">Selections</button>
                    }
                </div>
            </aside>
            @if (_selectionCount > 0)
            {
                <aside class="glass toolmenu" aria-label="Selection actions">
                    <span class="toolmenu-label">Actions</span>
                    <div class="unit-row" role="group" aria-label="Selection actions">
                        <button type="button" class="chip @(_moveStep is not null ? "active" : "")"
                                title="Move the selection from a base point to a destination"
                                disabled="@(_moveStep is not null)" @onclick="StartMove">Move</button>
                        @if ((_selectedItems > 0 || _selectedMeasurement is not null) && _moveStep is null)
                        {
                            <span class="toolmenu-divider" role="separator" aria-orientation="vertical"></span>
                        }
                        @if (_selectedItems > 0 && _moveStep is null)
                        {
                            <button type="button" class="chip danger" title="Delete selected drawing items (Delete or Backspace)"
                                    @onclick="RemoveSelectedItems">Delete @_selectedItems item@(_selectedItems == 1 ? "" : "s")</button>
                        }
                        @if (_selectedMeasurement is not null && _moveStep is null)
                        {
                            <button type="button" class="chip danger" @onclick="DeleteSelectedMeasurement">Delete measurement</button>
                        }
                    </div>
                </aside>
            }
            @if (_selectionMode == "lines")
            {
                <aside class="glass toolmenu" aria-label="Select options">
                    <span class="toolmenu-label">Options</span>
                    <div class="unit-row" role="group" aria-label="Select options">
                        <button type="button" class="chip check-chip @(_splitHandles ? "active" : "")"
                                role="checkbox"
                                title="Show the middle handle on selected lines; drag it to split the line"
                                aria-checked="@(_splitHandles.ToString().ToLowerInvariant())"
                                @onclick="ToggleSplitHandles">
                            <span class="check-box" aria-hidden="true">@(_splitHandles ? "✓" : "")</span>
                            Middle
                        </button>
                    </div>
                </aside>
            }
        </div>
    </div>
}

@if (_tool == "measurement")
{
    <div class="toolmenu-dock">
        @if (_measure is { Mode: "single" } m)
        {
            <section class="glass process-box measure-box" aria-label="Measurement" aria-live="polite">
                <div class="process-step">Measurement</div>
                <div class="measure-length">@m.Length</div>
                <dl class="measure-grid">
                    <dt>Point 1</dt><dd>x @m.Ax</dd><dd>y @m.Ay</dd>
                    <dt>Point 2</dt><dd>x @m.Bx</dd><dd>y @m.By</dd>
                    <dt>Δ</dt><dd>x @m.Dx</dd><dd>y @m.Dy</dd>
                </dl>
                @if (m.Dimension)
                {
                    <p class="process-text">Drag the blue dot to move the dimension line. Save it to the board, or click to start a new measurement.</p>
                    <div class="process-actions">
                        <button type="button" class="chip active default-action" data-default-action
                                title="Keep this measurement and its dimension on the board" @onclick="MeasurementSave">Save to board<span class="key-hint">Space</span></button>
                    </div>
                }
                else
                {
                    <p class="process-text">Drag the blue dot in the middle sideways to pull out a dimension line. Click to start a new measurement, or add more points to measure a total length and area.</p>
                    <div class="process-actions">
                        <button type="button" class="chip" title="Keep this measurement on the board" @onclick="MeasurementSave">Save to board</button>
                        <button type="button" class="chip active default-action" data-default-action
                                title="Keep clicking points to add them to the total length" @onclick="MeasurementAddPoints">Add points<span class="key-hint">Space</span></button>
                    </div>
                }
            </section>
        }
        else if (_measure is { } t)
        {
            <section class="glass process-box measure-box" aria-label="Measurement" aria-live="polite">
                <div class="process-step">Measurement · @(t.Mode == "multi" ? "Adding points" : "Result") · @t.Points points</div>
                <div class="measure-total">
                    <div>
                        <span class="measure-caption">Total length</span>
                        <div class="measure-length">@t.Length</div>
                    </div>
                    <div>
                        <span class="measure-caption">Area</span>
                        <div class="measure-length">@(t.Area ?? "—")</div>
                    </div>
                </div>
                @if (t.Mode == "multi")
                {
                    <p class="process-text">Click to add points. @(t.Area is null ? "The area appears from three points." : "The area closes back to the first point.")</p>
                    <div class="process-actions">
                        <button type="button" class="chip danger" data-default-action
                                title="Finish and keep the result" @onclick="MeasurementStop">Stop<span class="key-hint">Space</span></button>
                    </div>
                }
                else
                {
                    <div class="measure-caption">Show on board</div>
                    <div class="unit-row" role="group" aria-label="Measurement display">
                        @foreach (var (option, label, enabled) in new[]
                        {
                            ("showLengths", "Lengths", t.ShowLengths),
                            ("showAngles", "Angles", t.ShowAngles),
                            ("showArea", "Area", t.ShowArea)
                        })
                        {
                            <button type="button" class="chip check-chip @(enabled ? "active" : "")"
                                    role="checkbox" aria-checked="@(enabled.ToString().ToLowerInvariant())"
                                    @onclick="() => MeasurementToggleDisplay(option)">
                                <span class="check-box" aria-hidden="true">@(enabled ? "✓" : "")</span>
                                @label
                            </button>
                        }
                    </div>
                    <p class="process-text">Check points to include, or delete unwanted points. Save to keep changes.</p>
                    <div class="stack-list measure-point-list" role="group" aria-label="Measurement points">
                        @{ var nodes = t.Nodes ?? []; }
                        @for (var i = 0; i < nodes.Length; i++)
                        {
                            var index = i;
                            var point = nodes[i];
                            <div class="measure-point-row">
                                <button type="button" class="chip check-chip stack-end @(point.Selected ? "active" : "")"
                                        role="checkbox" aria-checked="@(point.Selected.ToString().ToLowerInvariant())"
                                        @onclick="() => MeasurementTogglePoint(index)">
                                    <span class="check-box" aria-hidden="true">@(point.Selected ? "✓" : "")</span>
                                    <span>@point.Label</span>
                                    <span class="stack-meta">x @point.X · y @point.Y</span>
                                </button>
                                <button type="button" class="chip danger" aria-label="@($"Delete {point.Label}")"
                                        title="@($"Delete {point.Label}")" @onclick="() => MeasurementDeletePoint(index)">Delete</button>
                            </div>
                        }
                    </div>
                    @if (!t.Dimension)
                    {
                        <div class="process-actions">
                            <button type="button" class="chip" title="Continue adding points after the last included point"
                                    @onclick="MeasurementAddPoints">Add points</button>
                        </div>
                    }
                    <div class="process-actions">
                        <button type="button" class="chip measure-cancel" @onclick="CancelMeasurement">Cancel</button>
                        <button type="button" class="chip active default-action" data-default-action
                                disabled="@(t.Points < 2)" @onclick="MeasurementSave">
                            @(t.Saved ? "Save changes" : "Save to board")<span class="key-hint">Space</span>
                        </button>
                    </div>
                    @if (t.Points < 2)
                    {
                        <p class="process-text">Include at least two points to save.</p>
                    }
                }
            </section>
        }
        <div class="toolmenu-row">
            <aside class="glass toolmenu" aria-label="Measurement toolmenu">
                <span class="toolmenu-label">Measurement</span>
                <div class="unit-row" role="group" aria-label="Snap to">
                    @foreach (var (mode, label, title) in new[]
                    {
                        ("grid", "Grid + nodes", "Snap to line ends, otherwise to the grid"),
                        ("nodes", "Nodes only", "Ignore the grid; only line ends can be picked")
                    })
                    {
                        <button type="button" class="chip @(_measurementSnap == mode ? "active" : "")" title="@title"
                                aria-pressed="@((_measurementSnap == mode).ToString().ToLowerInvariant())"
                                @onclick="() => SetMeasurementSnap(mode)">@label</button>
                    }
                </div>
            </aside>
            @if (_measure is { Saved: true })
            {
                <aside class="glass toolmenu" aria-label="Measurement actions">
                    <span class="toolmenu-label">Actions</span>
                    <button type="button" class="chip danger" @onclick="DeleteSelectedMeasurement">Delete measurement</button>
                </aside>
            }
        </div>
    </div>
}

@if (_tool == "line")
{
    <div class="toolmenu-dock">
        <div class="toolmenu-row">
            <aside class="glass toolmenu" aria-label="Line toolmenu">
                <span class="toolmenu-label">Line</span>
                <div class="unit-row" role="group" aria-label="Line options">
                    <button type="button" class="chip check-chip @(_lineMulti ? "active" : "")"
                            role="checkbox"
                            title="Keep drawing connected lines; uncheck to draw one line at a time"
                            aria-checked="@(_lineMulti.ToString().ToLowerInvariant())"
                            @onclick="ToggleLineMulti">
                        <span class="check-box" aria-hidden="true">@(_lineMulti ? "✓" : "")</span>
                        Multi
                    </button>
                    <button type="button" class="chip check-chip @(_lineDirectAdd ? "active" : "")"
                            role="checkbox"
                            title="Enter an exact line length beside the cursor"
                            aria-checked="@(_lineDirectAdd.ToString().ToLowerInvariant())"
                            @onclick="ToggleLineDirectAdd">
                        <span class="check-box" aria-hidden="true">@(_lineDirectAdd ? "✓" : "")</span>
                        Direct add
                    </button>
                </div>
            </aside>
        </div>
    </div>
}

@if (_tool is "circle" or "rectangle")
{
    <div class="toolmenu-dock">
        <ShapeInfoBox @key="_tool" Type="@_tool" Info="_shapeInfo" UnitLabel="@ShapeInputUnit.Label"
                      UnitMm="ShapeInputUnit.Mm" Error="@_shapeError"
                      OnDimension="ChangeShapeDimension" OnUseCursor="UseShapeCursor"
                      OnCancel="CancelShape" OnPlace="SaveShape" />
    </div>
}

@if (_tool == "symbol")
{
    <div class="toolmenu-dock">
        <SymbolInfoBox Info="_symbolInfo" Busy="_symbolBusy" Error="@_symbolError" Warning="@_symbolWarning" OnChoose="ChooseSymbolProject"
                       OnRefresh="RefreshSymbol" OnOpenSource="OpenSymbolSource" OnScale="ChangeSymbolScale" OnClose="CloseSymbol" OnError="ShowSymbolError"
                           Recent="_symbolRecent" OnRecent="PlaceRecentSymbol" OnForgetRecent="ForgetRecentSymbol"
                           OnLayerVisible="SetSymbolLayerVisible" OnUseSourceLayers="UseSymbolSourceLayers" OnKeepLocalLayers="KeepSymbolLocalLayers" />
    </div>
}

@if (_tool == "text")
{
    <div class="toolmenu-dock">
        @TextInfoBox
    </div>
}

@if (_tool == "point" && _pointInfo is { } pointToolInfo)
{
    <div class="toolmenu-dock">
        <PointInfoBox Info="pointToolInfo" OnMarkerChanged="ChangePointMarker" />
    </div>
}

@if (_layers is { } layers && _pages is { } panelPages)
{
    <SidePanel @ref="_boardPanel" Label="Pages and Layers">
        <Pages>
            <PagesPanel State="panelPages" OnAdd="AddPage" OnSelect="SelectPage" OnToggleVisible="SetPageVisible" OnToggleLocked="SetPageLocked" />
        </Pages>
        <Layers>
            <LayersPanel State="layers" CanAssign="@CanAssignLayer" Error="@_layerError" OnAdd="AddLayer" OnRemove="RequestLayerRemoval"
