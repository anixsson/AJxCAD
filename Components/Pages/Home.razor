    private async Task SymbolCall(Func<IJSObjectReference, Task> action, bool showBusy = true)
    {
        if (_cad is null || _symbolBusy || _symbolCallActive) return;
        _symbolCallActive = true;
        _symbolBusy = showBusy;
        _symbolError = null;
        try
        {
            await action(_cad);
        }
        catch (Exception ex) when (ex is JSException or IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            ShowSymbolError(ex.Message);
