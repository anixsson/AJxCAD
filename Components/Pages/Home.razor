    private sealed record PagePdf(string Name, string Pdf);

    private async Task<PagePdf> CreatePdf(int id)
    {
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");
        return await _cad.InvokeAsync<PagePdf>("getPagePdf", id);
    }

    private static string PdfFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var safe = new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray()).Trim();
        return $"{(safe.Length == 0 ? "Page" : safe)}.pdf";
    }

    private async Task RunPrintAction(Func<Task<string?>> action)
    {
        if (_printing) return;
        _printing = true;
        _printError = null;
        _printStatus = null;
        _exportedPath = null;
        try
        {
            _printStatus = await action();
        }
        catch (Exception ex)
        {
            _printError = ex.Message;
            Log("error", $"print/export failed: {ex.Message}");
        }
        finally
        {
            _printing = false;
        }
    }

    // Writes the PDF to the app cache and hands it to the system print dialog.
    private Task PrintPage(int id) => RunPrintAction(async () =>
    {
        var page = await CreatePdf(id);
        var folder = Path.Combine(FileSystem.CacheDirectory, "print");
        Directory.CreateDirectory(folder);
        var path = Path.Combine(folder, PdfFileName(page.Name));
        await File.WriteAllTextAsync(path, page.Pdf, System.Text.Encoding.ASCII);
        Log("action", $"print {path}");
        await PrintService.PrintPdfAsync(path);
        return null;
    });

    private Task ExportPage(int id) => RunPrintAction(async () =>
    {
        var page = await CreatePdf(id);
        await using var stream = new MemoryStream(System.Text.Encoding.ASCII.GetBytes(page.Pdf));
        var result = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync(PdfFileName(page.Name), stream);
        if (result.IsSuccessful)
        {
            Log("action", $"exported {result.FilePath}");
            _exportedPath = result.FilePath;
            return $"Saved {result.FilePath}";
        }
        if (result.Exception is not null and not OperationCanceledException) throw result.Exception;
        return null;
    });

    private void OpenExportLocation() => RunExportedFileAction("open location", PrintService.RevealFile);

    private void OpenExportedFile() => RunExportedFileAction("open pdf", PrintService.OpenFile);

    private void RunExportedFileAction(string what, Action<string> action)
    {
        if (_exportedPath is null) return;
        _printError = null;
        try
        {
            action(_exportedPath);
        }
        catch (Exception ex)
        {
            _printError = ex.Message;
            Log("error", $"{what} failed: {ex.Message}");
        }
    }

