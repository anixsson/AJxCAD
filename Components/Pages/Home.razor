    private sealed record ProjectData(string Name, int Imperial, double UnitMm);

    private static readonly FilePickerFileType ProjectFileType = new(new Dictionary<DevicePlatform, IEnumerable<string>>
    {
        // Declared in Platforms/MacCatalyst/Info.plist (UTExportedTypeDeclarations) for the .ajx extension.
        [DevicePlatform.MacCatalyst] = ["com.companyname.ajxcad.project"],
        [DevicePlatform.WinUI] = [".ajx"]
    });

    [JSInvokable]
    public async Task OnFileCommand(string command)
    {
        _openMenu = null;
        switch (command)
        {
            case "new": await RequestProjectAction(ProjectAction.New); break;
            case "open": await RequestProjectAction(ProjectAction.Open); break;
            case "save": await SaveProject(false); break;
            case "saveas": await SaveProject(true); break;
            case "print": await OpenPrint(); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task Alert(string title, string message)
    {
        var page = Application.Current?.Windows.FirstOrDefault()?.Page;
        if (page is not null) await page.DisplayAlertAsync(title, message, "OK");
    }

    private async Task NewProject()
    {
        if (_cad is null) return;
        await _cad.InvokeVoidAsync("newProject");
        _filePath = null;
        _projectName = "Untitled";
        await SyncProject();
        await MarkProjectClean();
        Log("action", "new project");
    }

    private string? _savedContent;
    private bool _unsaved;
    private enum ProjectAction { Quit, New, Open }
    private ProjectAction? _pendingProjectAction;
    private bool _checkingProjectAction;
    private bool _continuingProjectAction;
    private bool _savingProject;
    private sealed record SaveSnapshot(string Text, string Content);
    private bool ProjectActionBusy => _savingProject || _continuingProjectAction;
    private string PendingActionDescription => _pendingProjectAction switch
    {
        ProjectAction.New => "creating a new project",
        ProjectAction.Open => "opening another project",
        _ => "quitting"
    };
    private string SaveChangesTitle => _pendingProjectAction switch
    {
        ProjectAction.New => "Save before creating a new project?",
        ProjectAction.Open => "Save before opening another project?",
        _ => "Save before quitting?"
    };

    private async Task MarkProjectClean()
    {
        if (_cad is not null) await SetSavedContent(await _cad.InvokeAsync<string>("getContentText"));
    }

    private async Task SetSavedContent(string content)
    {
        _savedContent = content;
        if (_cad is not null) _unsaved = await _cad.InvokeAsync<bool>("setSavedContent", content);
    }

    [JSInvokable]
    public void OnUnsavedChanged(bool unsaved)
    {
        _unsaved = unsaved;
        StateHasChanged();
    }

    private async void OnNativeCloseRequested()
    {
        await InvokeAsync(RequestQuit);
    }

    private Task RequestQuit() => RequestProjectAction(ProjectAction.Quit);

    private async Task RequestProjectAction(ProjectAction action)
    {
        if (_checkingProjectAction || ProjectActionBusy || _pendingProjectAction is not null) return;
        _openMenu = null;
        _checkingProjectAction = true;
        try
        {
            if (_cad is null || _savedContent is null)
            {
                await Alert("Please wait", "The project is still loading. Try again when it has finished.");
                return;
            }
            if (await _cad.InvokeAsync<string>("getContentText") == _savedContent)
            {
                await ExecuteProjectAction(action);
                return;
            }
            _pendingProjectAction = action;
            await OpenDialog("save-changes");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log("error", $"could not check unsaved changes: {ex.Message}");
            await Alert("Could not continue", ex.Message);
        }
        finally
        {
            _checkingProjectAction = false;
        }
    }

    private async Task ExecuteProjectAction(ProjectAction action)
    {
        switch (action)
        {
            case ProjectAction.Quit: NativeWindow.Quit(); break;
            case ProjectAction.New: await NewProject(); break;
            case ProjectAction.Open: await OpenProject(); break;
        }
    }

    private async Task ContinueProjectAction(bool save)
    {
        if (ProjectActionBusy || _pendingProjectAction is not { } action) return;
        _continuingProjectAction = true;
        try
        {
            if (save && !await SaveProject(false)) return;
            _pendingProjectAction = null;
            _dialog = null;
            await ExecuteProjectAction(action);
        }
        catch (Exception ex)
        {
            Log("error", $"project action failed: {ex.Message}");
            await Alert("Could not continue", ex.Message);
        }
        finally
        {
            _continuingProjectAction = false;
        }
    }

    private async Task<bool> SaveProject(bool saveAs)
    {
        if (_cad is null || _savingProject) return false;
        _savingProject = true;
        try
        {
            await SyncProject();
            var snapshot = await _cad.InvokeAsync<SaveSnapshot>("getSaveSnapshot");
            var text = snapshot.Text;

            if (!saveAs && _filePath is not null)
            {
                try
                {
                    await File.WriteAllTextAsync(_filePath, text);
                    await SetSavedContent(snapshot.Content);
                    Log("action", $"saved {_filePath}");
                    return true;
                }
                catch (Exception ex) when (ex is UnauthorizedAccessException or IOException)
                {
                    Log("action", $"could not write {_filePath} ({ex.Message}), asking for a location");
                }
            }

            await using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(text));
            var result = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync($"{_projectName}.ajx", stream);
            if (result.IsSuccessful)
            {
                _filePath = result.FilePath;
                await SetSavedContent(snapshot.Content);
                Log("action", $"saved {_filePath}");
                return true;
            }
            else if (result.Exception is not null)
            {
                await Alert("Save failed", result.Exception.Message);
            }
        }
        catch (Exception ex)
        {
            Log("error", $"save failed: {ex.Message}");
            await Alert("Save failed", ex.Message);
        }
        finally
        {
            _savingProject = false;
        }
        return false;
    }

    private async Task OpenProject()
    {
        if (_cad is null) return;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = "Open project", FileTypes = ProjectFileType });
            if (file is null) return;

            string text;
            await using (var stream = await file.OpenReadAsync())
            using (var reader = new StreamReader(stream)) text = await reader.ReadToEndAsync();

            await _cad.InvokeAsync<int>("loadDataText", text);
            _filePath = file.FullPath;
            await _cad.InvokeVoidAsync("refreshSymbols");
            await ApplyProject(await _cad.InvokeAsync<ProjectData>("getProjectData"));
            await MarkProjectClean();
            Log("action", $"opened {_filePath}");
        }
        catch (Exception ex)
        {
            Log("error", $"open failed: {ex.Message}");
            await Alert("Could not open file", "This is not a valid AJxCAD project file.\n\n" + ex.Message);
        }
    }

    // Brings the scale panel in line with the project bucket that was just loaded.
    private async Task ApplyProject(ProjectData p)
    {
        _projectName = p.Name;
        _imperial = p.Imperial != 0;
        _unit = Units.FirstOrDefault(u => Math.Abs(u.Mm - p.UnitMm) < 1e-9) ?? (_imperial ? ImperialUnits[1] : MetricUnits[2]);
        if (_cad is null) return;
        await _cad.InvokeVoidAsync("setImperial", _imperial);
        await _cad.InvokeVoidAsync("setReference", _unit.Mm);
        await _cad.InvokeVoidAsync("restoreView");
    }

    private bool _settingsOpen;
    private bool _centered = true;
    private bool _imperial;
    private UnitDef _unit = MetricUnits[2];
    private double _scale = ReferencePx / MetricUnits[2].Mm; // pixels per mm

    private UnitDef[] Units => _imperial ? ImperialUnits : MetricUnits;
    private double OneToOne => ReferencePx / _unit.Mm;

    private double BarMm => NiceAtMost(MaxBarPx / (_scale * _unit.Mm)) * _unit.Mm;
    private double BarPx => BarMm * _scale;
    private string BarText => FormatLength(BarMm);
    private UnitDef ShapeInputUnit => LengthUnit(BarMm);

    private double MinorMm
    {
        get
        {
            var v = 12 / (_scale * _unit.Mm);
            var pow = Math.Pow(10, Math.Floor(Math.Log10(v)));
            foreach (var m in new[] { 1, 2, 5, 10 })
                if (m * pow >= v) return m * pow * _unit.Mm * Math.Pow(2, _gridSizeStep);
            return 10 * pow * _unit.Mm * Math.Pow(2, _gridSizeStep);
        }
    }

    private bool IsOneToOne => Math.Abs(_scale / OneToOne - 1) < 0.005;

    private string RatioText
    {
        get
        {
            if (IsOneToOne) return "1 : 1";
            var zoom = _scale / OneToOne;
            var v = zoom >= 1 ? zoom : 1 / zoom;
            var text = v.ToString(v < 10 ? "0.##" : v < 100 ? "0.#" : "0", System.Globalization.CultureInfo.InvariantCulture);
            return zoom >= 1 ? $"{text} : 1" : $"1 : {text}";
        }
    }

    private UnitDef LengthUnit(double mm)
    {
        if (_imperial)
        {
            var inches = mm / 25.4;
            if (inches < 12) return new("in", 25.4);
            if (inches < 12 * 5280) return new("ft", 304.8);
            return new("mi", 1_609_344);
        }

        if (mm < 10) return new("mm", 1);
        if (mm < 1000) return new("cm", 10);
        if (mm < 1_000_000) return new("m", 1000);
        return new("km", 1_000_000);
    }

    private string FormatLength(double mm)
    {
        var unit = LengthUnit(mm);
        return $"{Num(mm / unit.Mm)} {unit.Label}";
    }

    private static string Num(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_debug && _debugOpen && _cad is not null) await _cad.InvokeVoidAsync("stickToBottom", _logBox);
        if (!firstRender)
        {
            await ApplyAppearance();
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _cad = await JS.InvokeAsync<IJSObjectReference>("import", "./cad/engine.js");
        await _cad.InvokeVoidAsync("init", _workspace, _canvas, _self, ReferencePx, _unit.Mm);
        await _cad.InvokeVoidAsync("setExtendedZoom", _extendedZoom);
        await _cad.InvokeVoidAsync("setGridColor", _gridColor);
        await _cad.InvokeVoidAsync("setGridSizeStep", _gridSizeStep);
        await _cad.InvokeVoidAsync("setSnapOptions", _gridSnap, _midpointSnap, _referenceSnap);
        await ApplyAppearance();
        await SyncProject();
        await MarkProjectClean();
        NativeWindow.CloseRequested += OnNativeCloseRequested;
        _pages = await _cad.InvokeAsync<PagesState>("getPages");
        _layers = await _cad.InvokeAsync<LayersState>("getLayers");
        StateHasChanged();
    }

