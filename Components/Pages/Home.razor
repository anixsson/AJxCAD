<nav class="menu-bar" aria-label="Main menu">
    <div class="glass menu-glass"></div>
    <span class="float-menu-brand">AJxCAD</span>
    @foreach (var menu in Menus)
    {
        var open = _openMenu == menu.Label;
        <div class="menu-group">
            <button type="button" class="float-btn @(open ? "open" : "")" aria-haspopup="menu" aria-expanded="@open.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleMenu(menu.Label)"
                    @onpointerenter="() => HoverMenu(menu.Label)">@menu.Label</button>
            @if (open)
            {
                <div class="glass flyout" role="menu">
                    @foreach (var item in menu.Items)
                    {
                        if (item.IsSeparator)
                        {
                            <div class="flyout-sep" role="separator"></div>
                        }
                        else
                        {
                            var captured = item;
                            <button type="button" class="flyout-item" role="menuitem" disabled="@(captured.Action is null)" @onclick="() => RunItem(captured)">
                                <span class="flyout-check">@(captured.Checked?.Invoke() == true ? "✓" : "")</span>
                                <span class="flyout-label">@captured.Label</span>
                                <span class="flyout-shortcut">@captured.Shortcut</span>
                            </button>
                        }
                    }
                </div>
            }
        </div>
    }
</nav>

@if (_optimizerCount > 0)
{
    <aside class="glass optimizer-panel" aria-label="Optimize view" aria-live="polite">
        <div class="process-step">Optimize view</div>
        <label class="process-text">
            <input type="checkbox" checked="@_optimizerEnabled" @onchange="ToggleOptimizer" />
            Hide objects smaller than 3 screen pixels
        </label>
        <p class="process-text">@_optimizerCount.ToString("N0") objects @(_optimizerEnabled ? "hidden" : "can be hidden") at this zoom.</p>
        <p class="process-text">Uncheck to show all objects; check again to render fewer. Hidden objects cannot be selected or snapped to. Point markers stay visible.</p>
        <p class="process-text">Print preview, printing and PDF export never use this optimizer. Layer visibility/Print settings and explicit point-marker visibility still apply; no objects are omitted just because they are small.</p>
    </aside>
}

<aside class="float-panel snap-panel" aria-label="Snap options">
    <span class="snap-caption">Snap</span>
    <button type="button" class="float-btn snap-btn @(_midpointSnap ? "active" : "")" role="checkbox"
            aria-checked="@_midpointSnap.ToString().ToLowerInvariant()"
            title="Add temporary snap nodes at the middle of every line and each rectangle side and centre"
            @onclick="ToggleMidpointSnap">Mid</button>
    <button type="button" class="float-btn snap-btn @(_referenceSnap ? "active" : "")" role="checkbox"
            aria-checked="@_referenceSnap.ToString().ToLowerInvariant()"
            title="Reference lines: rest the cursor on a node for a second to show horizontal and vertical guides through it, then snap along them. Rest on it again to remove them"
            @onclick="ToggleReferenceSnap">Ref</button>
    <span class="snap-divider" aria-hidden="true"></span>
    <button type="button" class="float-btn snap-btn @(_gridSnap ? "active" : "")" role="checkbox"
            aria-checked="@_gridSnap.ToString().ToLowerInvariant()" aria-label="Grid snapping"
            title="@(_gridSnap ? "Grid snapping is on for all tools. Click to place and move freely" : "Grid snapping is off for all tools. Click to snap to the grid again")"
            @onclick="ToggleGridSnap">Grid</button>
    <button type="button" class="float-btn snap-btn" title="Halve the grid spacing" aria-label="Decrease grid size"
            disabled="@(_gridSizeStep <= -2)" @onclick="() => ChangeGridSize(-1)">−</button>
    <button type="button" class="float-btn snap-btn" title="Double the grid spacing" aria-label="Increase grid size"
            disabled="@(_gridSizeStep >= 2)" @onclick="() => ChangeGridSize(1)">+</button>
</aside>

<aside class="float-panel scale-panel" aria-label="Scale">
    <div class="scale-readout">
        <div class="scale-actions">
            <button type="button" class="float-btn @(IsOneToOne ? "active" : "")" title="Reset to 1:1" @onclick="ResetToOneToOne">1:1</button>
            <button type="button" class="float-btn @(_centered ? "active" : "")" title="Return to the origin at the current scale" @onclick="CenterView">Center</button>
        </div>
        <span class="scale-ratio">@RatioText</span>
    </div>
    <div class="scale-grid-info">Grid @FormatLength(MinorMm) · Major @FormatLength(MinorMm * 10)</div>
    <div class="scale-bar-row">
        <div class="scale-bar" style="width:@Css(BarPx)px"></div>
        <span class="scale-bar-label">@BarText</span>
        <button type="button" class="accordion-toggle" title="Scale settings" aria-label="Scale settings" aria-expanded="@_settingsOpen.ToString().ToLowerInvariant()" @onclick="() => _settingsOpen = !_settingsOpen">
            <span class="chevron @(_settingsOpen ? "open" : "")"></span>
        </button>
    </div>

    <div class="accordion-body @(_settingsOpen ? "open" : "")">
        <div class="accordion-inner">
            <div class="unit-row" role="group" aria-label="Unit system">
                <button type="button" class="chip @(!_imperial ? "active" : "")" @onclick="() => SetSystem(false)">Metric</button>
                <button type="button" class="chip @(_imperial ? "active" : "")" @onclick="() => SetSystem(true)">Imperial</button>
            </div>
            <div class="unit-row" role="group" aria-label="1:1 equals">
                <span class="unit-caption">1:1 =</span>
                @foreach (var u in Units)
                {
                    <button type="button" class="chip @(u == _unit ? "active" : "")" @onclick="() => SetUnit(u)">@u.Label</button>
                }
            </div>
            <div class="unit-row" role="group" aria-label="Zoom">
                <span class="unit-caption">Zoom</span>
                <button type="button" class="chip" title="Zoom out" @onpointerdown="() => HoldStart(-1)" @onpointerup="HoldStop" @onpointerleave="HoldStop" @onpointercancel="HoldStop">−</button>
                <button type="button" class="chip" title="Zoom in" @onpointerdown="() => HoldStart(1)" @onpointerup="HoldStop" @onpointerleave="HoldStop" @onpointercancel="HoldStop">+</button>
            </div>
        </div>
    </div>
</aside>
</div>

@code {
    private bool _optimizerEnabled = true;
    private int _optimizerCount;

    [JSInvokable]
    public void OnOptimizerChanged(bool enabled, int count)
    {
        _optimizerEnabled = enabled;
        _optimizerCount = count;
        StateHasChanged();
    }

    private async Task ToggleOptimizer(ChangeEventArgs e)
    {
        if (_cad is null) throw new InvalidOperationException("The drawing workspace is not ready.");
        await _cad.InvokeVoidAsync("setOptimizerEnabled", e.Value is true);
    }

    private sealed record UnitDef(string Label, double Mm);

    private static readonly UnitDef[] MetricUnits = [new("1 mm", 1), new("1 cm", 10), new("1 m", 1000)];
    private static readonly UnitDef[] ImperialUnits = [new("1 in", 25.4), new("1 ft", 304.8), new("1 yd", 914.4)];

    // At 1:1 one chosen unit is one major grid cell, this many CSS pixels wide.
    private const double ReferencePx = 160;
    private const double MaxBarPx = 140;

    private sealed record MenuItem(string Label, string? Shortcut = null, Func<Task>? Action = null, Func<bool>? Checked = null)
    {
        public bool IsSeparator => Label == "-";
    }

    private sealed record MenuDef(string Label, MenuItem[] Items);

    private static readonly MenuItem Separator = new("-");

    private IEnumerable<MenuDef> Menus => (_menus ??=
    [
        new("File",
        [
            new("New", "⌘N", () => OnFileCommand("new")), new("Open…", "⌘O", () => OnFileCommand("open")),
            new("Save", "⌘S", () => OnFileCommand("save")), new("Save As…", "⇧⌘S", () => OnFileCommand("saveas")),
            Separator,
            new("Print / Export…", "⌘P", () => OnFileCommand("print")),
            Separator,
            new("Project settings…", null, () => OpenDialog("project")),
            new("Data buckets…", null, ShowData),
            Separator,
            new("App settings…", "⌘,", () => OpenDialog("settings")),
            Separator,
            new("Quit", "⌘Q", RequestQuit)
        ]),
        new("Edit",
        [
            new("Undo", "⌘Z", Undo), new("Redo", "⇧⌘Z"),
            Separator,
            new("Cut", "⌘X"), new("Copy", "⌘C"), new("Paste", "⌘V")
        ]),
        new("View",
        [
            new("Zoom to 1:1", null, ResetToOneToOne),
            new("Center view", null, CenterView),
            Separator,
            new("Zoom in", null, () => StepZoom(1)),
            new("Zoom out", null, () => StepZoom(-1)),
            Separator,
            new("Scale settings", null, () => { _settingsOpen = !_settingsOpen; return Task.CompletedTask; }, () => _settingsOpen)
        ]),
        new("Debug",
        [
            new("Debug window", null, () => { _debug = !_debug; return Task.CompletedTask; }, () => _debug),
            new("Test data…", null, () => OpenDialog("testdata"))
        ]),
        new("Help",
        [
            new("User guide", null, () => OpenDialog("guide")),
            new("About AJxCAD", null, () => OpenDialog("about"))
        ])
    ]).Where(menu => menu.Label != "Debug" || _showDebugMenu);

    private MenuDef[]? _menus;
    private string? _openMenu;

    private void ToggleMenu(string label)
    {
        _openMenu = _openMenu == label ? null : label;
        Log("action", $"menu {label}: {(_openMenu is null ? "closed" : "opened")}");
    }
    private void HoverMenu(string label) { if (_openMenu is not null) _openMenu = label; }
    private void CloseMenu() => _openMenu = null;

    private async Task RunItem(MenuItem item)
    {
        _openMenu = null;
        if (item.Action is not null) await item.Action();
    }

    private async Task StepZoom(int direction)
    {
        await HoldStart(direction);
        await HoldStop();
    }

    private string? _dialog;
    private bool _debug = false;
    private bool _showDebugMenu = BuildInfo.IsDebug;
    private readonly List<(string Time, string Kind, string Text)> _log = new();

    private ElementReference _logBox;
    private bool _debugOpen = true;

    private void ToggleDebug() => _debugOpen = !_debugOpen;

    private void SetShowDebugMenu(bool show)
    {
        _showDebugMenu = show;
        if (!_showDebugMenu)
        {
            _debug = false;
            if (_openMenu == "Debug") _openMenu = null;
            if (_dialog == "testdata") _dialog = null;
        }
    }

    private async Task GenerateTestData(TestDataDialog.TestDataOptions options)
    {
        if (!_showDebugMenu)
            throw new InvalidOperationException("Test data is available only when the Debug menu is enabled.");
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");

        await _cad.InvokeVoidAsync("generateTestData", options.Kind, options.Count, options.Spacing);
    }

    // Oldest first, newest at the bottom; capped so it stays cheap.
    private void Log(string kind, string text)
    {
        _log.Add((DateTime.Now.ToString("HH:mm:ss.fff"), kind, text));
        if (_log.Count > 500) _log.RemoveAt(0);
    }

    [JSInvokable]
    public void OnLog(string kind, string text)
    {
        Log(kind, text);
        StateHasChanged();
    }
    private string _tool = "cross";
    private string _selectionMode = "nodes";

    private async Task SetSelectionMode(string mode)
    {
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");

        await _cad.InvokeVoidAsync("setSelectionMode", mode);
        _selectionMode = mode;
    }

    private bool _splitHandles = true;

    private async Task ToggleSplitHandles()
    {
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");

        await _cad.InvokeVoidAsync("setSplitHandles", !_splitHandles);
        _splitHandles = !_splitHandles;
    }

    private int _selectionCount;
    private string? _moveStep; // null, "base" or "target"
    private bool _moveHasBase;

    [JSInvokable]
    public void OnSelectionChanged(int count)
    {
        _selectionCount = count;
        StateHasChanged();
    }

    private int _selectedItems;

    [JSInvokable]
    public void OnDrawingItemSelectionChanged(int count)
    {
        _selectedItems = count;
        StateHasChanged();
    }

    private async Task RemoveSelectedItems()
    {
        if (_cad is not null) await _cad.InvokeAsync<int>("removeSelectedItems");
    }

    [JSInvokable]
    public void OnProcessChanged(string? step, bool hasBase)
    {
        _moveStep = step;
        _moveHasBase = hasBase;
        StateHasChanged();
    }

    private async Task StartMove()
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("startMove");
    }

    private async Task ConfirmMoveBase()
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("confirmMoveBase");
    }

    private async Task CancelProcess()
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("cancelProcess");
    }

    public sealed record StackEnd(string Label, bool Selected, string? Length, string? To, bool Area = false);
    public sealed record StackInfo(string X, string Y, StackEnd[] Ends, bool Shared = true);

    public sealed record SelectedMeasurement(int Id, string Length, string? Area, int Points);
    private SelectedMeasurement? _selectedMeasurement;

    [JSInvokable]
    public void OnSelectedMeasurement(SelectedMeasurement? measurement)
    {
        _selectedMeasurement = measurement;
        StateHasChanged();
    }

    private async Task EditMeasurement(int id)
    {
        if (_cad is not null) await _cad.InvokeVoidAsync("editMeasurement", id);
    }

    private StackInfo? _stack;

    [JSInvokable]
    public void OnStackChanged(StackInfo? stack)
    {
        _stack = stack;
        StateHasChanged();
    }

    private async Task ToggleStackEnd(int index)
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("toggleStackEnd", index);
    }

    public sealed record SelectionEntry(string Label, string Kind, string? Detail, bool Selected);
    public sealed record SelectionList(SelectionEntry[] Entries);
    private SelectionList? _selectionList;

    [JSInvokable]
    public void OnSelectionListChanged(SelectionList? list)
    {
        _selectionList = list;
        StateHasChanged();
    }

    private async Task ToggleSelectionList()
    {
        if (_cad is null) return;
        await _cad.InvokeAsync<bool>(_selectionList is null ? "openSelectionList" : "closeSelectionList");
    }

    private async Task CloseSelectionList()
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("closeSelectionList");
    }

    private async Task ToggleSelectionEntry(int index)
    {
        if (_cad is not null) await _cad.InvokeAsync<bool>("toggleSelectionEntry", index);
    }

    public sealed record MeasurementPoint(string Label, string X, string Y, bool Selected);
    public sealed record Measurement(string Mode, string Length, int Points,
        string? Dx = null, string? Dy = null, string? Ax = null, string? Ay = null, string? Bx = null, string? By = null,
        string? Area = null, bool Saved = false, MeasurementPoint[]? Nodes = null,
        bool ShowLengths = true, bool ShowAngles = true, bool ShowArea = true, bool Dimension = false);

    private string _measurementSnap = "grid";
    private bool _lineMulti = true;
    private bool _lineDirectAdd = true;

    private async Task ToggleLineDirectAdd()
    {
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");

        await _cad.InvokeVoidAsync("setLineDirectAdd", !_lineDirectAdd);
        _lineDirectAdd = !_lineDirectAdd;
    }

    private async Task ToggleLineMulti()
    {
        if (_cad is null)
            throw new InvalidOperationException("The drawing workspace is not ready.");

        await _cad.InvokeVoidAsync("setLineMulti", !_lineMulti);
        _lineMulti = !_lineMulti;
    }

    private PointInfoBox.PointInfo? _pointInfo;
    private PointInfoBox.SettingsChange _projectPointSettings = new(100, "local");
    private string? _pointSettingsError;

    [JSInvokable]
    public void OnPointChanged(PointInfoBox.PointInfo? info)
    {
        _pointInfo = info;
        if (info is not null) _projectPointSettings = new(info.Scale, info.Visibility);
        StateHasChanged();
    }

    private async Task ChangePointSettings(PointInfoBox.SettingsChange change)
    {
        try
        {
            if (_cad is null) throw new InvalidOperationException("The drawing workspace is not ready.");
            await _cad.InvokeVoidAsync("updatePointSettings", change.Scale, change.Visibility);
            _projectPointSettings = await _cad.InvokeAsync<PointInfoBox.SettingsChange>("getPointSettings");
            _pointSettingsError = null;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _pointSettingsError = ex.Message;
            Log("error", $"Could not update point settings: {ex.Message}");
        }
    }

    private async Task ChangePointMarker(PointInfoBox.MarkerChange change)
    {
        try
        {
            if (_cad is null) throw new InvalidOperationException("The drawing workspace is not ready.");
            await _cad.InvokeVoidAsync("updatePointMarker", change.Id, change.Show);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Log("error", $"Could not update point marker: {ex.Message}");
        }
    }

    public sealed record TextInfo(string Mode, int? Id, string Text, double X, double Y, double FontSize,
        string FontFamily, bool Bold, bool Italic, bool Underline);
    private TextInfo? _textInfo;
    private ShapeInfoBox.ShapeInfo? _shapeInfo;
    private string? _shapeError;

    [JSInvokable]
    public void OnShapeChanged(ShapeInfoBox.ShapeInfo? info)
    {
        _shapeInfo = info;
        if (info is null) _shapeError = null;
        StateHasChanged();
    }

    private Task ChangeShapeDimension(ShapeInfoBox.DimensionChange change) =>
        ShapeAction("setShapeDimension", change.Field, change.Value);
    private Task UseShapeCursor() => ShapeAction("useShapeCursor");
    private Task CancelShape() => ShapeAction("cancelShape");
    private Task SaveShape() => ShapeAction("saveShape");

    private async Task ShapeAction(string action, params object[] args)
    {
        try
        {
            if (_cad is null) throw new InvalidOperationException("The drawing engine is not ready.");
            await _cad.InvokeVoidAsync(action, args);
            _shapeError = null;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _shapeError = ex.Message;
            Log("error", $"Could not update shape: {ex.Message}");
        }
    }

    private RenderFragment TextInfoBox => __builder =>
    {
    <section class="glass process-box" aria-label="Text tool" aria-live="polite">
        <div class="process-step">@(_textInfo?.Mode == "edit" ? "Text information" : "Text")</div>
        @if (_textInfo is { } textInfo)
        {
