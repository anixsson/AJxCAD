    private Task ChooseSymbolProject() => SymbolCall(async cad =>
    {
        var id = _symbolInfo?.Id;
        var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = "Import symbol from project", FileTypes = ProjectFileType });
        if (file is null) return;
        if (_filePath is not null && Path.GetFullPath(file.FullPath) == Path.GetFullPath(_filePath))
            throw new InvalidOperationException("Select another project, not the current project.");
        await using var stream = await file.OpenReadAsync();
        using var reader = new StreamReader(stream);
        var text = await reader.ReadToEndAsync();
        var warning = SymbolSourceFiles.RememberAccess(file.FullPath);
        if (id is not null)
        {
            await cad.InvokeVoidAsync("reloadSymbol", id.Value, file.FullPath, text);
        }
        else
        {
            await cad.InvokeVoidAsync("prepareSymbol", file.FullPath, text);
        }
        _symbolRecent = SymbolSourceFiles.AddRecent(file.FullPath);
        _symbolWarning = warning;
        if (warning is not null) Log("warning", warning);
    });

    private Task PlaceRecentSymbol(string source) => SymbolCall(async cad =>
    {
        if (_filePath is not null && Path.GetFullPath(source) == Path.GetFullPath(_filePath))
            throw new InvalidOperationException("Select another project, not the current project.");
        var text = await SymbolSourceFiles.ReadTextAsync(source, warning => Log("warning", warning));
        await cad.InvokeVoidAsync("prepareSymbol", source, text);
        _symbolRecent = SymbolSourceFiles.AddRecent(source);
        Log("action", $"placing recent symbol {source}");
    });

