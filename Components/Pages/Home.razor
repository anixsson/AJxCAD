                        aria-label="Decrease font size"
                        @onpointerdown="() => FontSizeHoldStart(-1)" @onpointerup="FontSizeHoldStop"
                        @onpointerleave="FontSizeHoldStop" @onpointercancel="FontSizeHoldStop"
                        @onclick="e => FontSizeClick(-1, e)">−</button>
                <button type="button" class="chip text-font-size-button" title="Increase font size"
                        aria-label="Increase font size"
                        @onpointerdown="() => FontSizeHoldStart(1)" @onpointerup="FontSizeHoldStop"
                        @onpointerleave="FontSizeHoldStop" @onpointercancel="FontSizeHoldStop"
                        @onclick="e => FontSizeClick(1, e)">+</button>
            </div>
            <input class="text-font-size-slider" type="range" min="1" max="@MaxFontSize" step="0.5"
                   aria-label="Text font size in millimetres"
                   value="@textInfo.FontSize.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   @oninput="e => ChangeTextDraft(nameof(textInfo.FontSize), e.Value)" />
            <label class="measure-caption" for="board-text-family">Font family</label>
            <select id="board-text-family" class="text-input text-tool-input" value="@textInfo.FontFamily"
                    @onchange="e => ChangeTextDraft(nameof(textInfo.FontFamily), e.Value)">
                <option value="sans-serif">Sans serif</option>
                <option value="serif">Serif</option>
                <option value="monospace">Monospace</option>
            </select>
            <div class="unit-row text-style-buttons" role="group" aria-label="Text styles">
                @foreach (var (property, label, enabled) in new[]
                {
                    ("Bold", "Bold", textInfo.Bold),
                    ("Italic", "Italic", textInfo.Italic),
                    ("Underline", "Underline", textInfo.Underline)
                })
                {
                    <button type="button" class="chip check-chip @(enabled ? "active" : "")" role="checkbox"
                            aria-checked="@enabled.ToString().ToLowerInvariant()"
                            @onclick="() => ChangeTextDraft(property, !enabled)">
                        <span class="check-box" aria-hidden="true">@(enabled ? "✓" : "")</span>@label
                    </button>
                }
            </div>
            <div class="process-actions">
                <button type="button" class="chip" @onclick="CancelText">Cancel</button>
                <button type="button" class="chip active default-action" data-default-action
                        disabled="@string.IsNullOrWhiteSpace(textInfo.Text)"
                        @onclick="SaveText">@(textInfo.Mode == "edit" ? "Save changes" : "Place text")<span class="key-hint">Space</span></button>
            </div>
        }
        else
        {
            <p class="process-text">Click the board to place a text anchor.</p>
        }
    </section>
    };
    private CancellationTokenSource? _fontSizeHold;

    [JSInvokable]
    public void OnTextChanged(TextInfo? info)
    {
        _textInfo = info;
        StateHasChanged();
    }

    private async Task ChangeTextDraft(string property, object? value)
    {
        if (_cad is null || _textInfo is null)
            throw new InvalidOperationException("The text editor is not open.");
        _textInfo = property switch
        {
            nameof(TextInfo.Text) => _textInfo with { Text = value?.ToString() ?? "" },
            nameof(TextInfo.FontSize) when double.TryParse(value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var size) => _textInfo with { FontSize = size },
            nameof(TextInfo.FontFamily) => _textInfo with { FontFamily = value?.ToString() ?? "" },
            nameof(TextInfo.Bold) => _textInfo with { Bold = Convert.ToBoolean(value) },
            nameof(TextInfo.Italic) => _textInfo with { Italic = Convert.ToBoolean(value) },
            nameof(TextInfo.Underline) => _textInfo with { Underline = Convert.ToBoolean(value) },
            _ => throw new ArgumentOutOfRangeException(nameof(property), property, "Unknown text setting")
        };
        await _cad.InvokeVoidAsync("setTextDraft", new
        {
            mode = _textInfo.Mode, id = _textInfo.Id, text = _textInfo.Text,
            x = _textInfo.X, y = _textInfo.Y, fontSize = _textInfo.FontSize,
            fontFamily = _textInfo.FontFamily, bold = _textInfo.Bold,
            italic = _textInfo.Italic, underline = _textInfo.Underline
        });
    }

    private async Task FontSizeHoldStart(int direction)
    {
        FontSizeHoldStop();
        if (_textInfo is null) return;

        var hold = new CancellationTokenSource();
        _fontSizeHold = hold;
        var delay = 400;
        try
        {
            await AdjustFontSize(direction);
            while (!hold.IsCancellationRequested && _textInfo is not null)
            {
                await Task.Delay(delay, hold.Token);
                delay = Math.Max(30, (int)(delay * 0.75));
                await AdjustFontSize(direction);
            }
        }
        catch (OperationCanceledException) when (hold.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_fontSizeHold, hold)) _fontSizeHold = null;
            hold.Dispose();
        }
    }

    private void FontSizeHoldStop()
    {
        _fontSizeHold?.Cancel();
        _fontSizeHold = null;
    }

    private Task FontSizeClick(int direction, MouseEventArgs args) =>
        args.Detail == 0 ? AdjustFontSize(direction) : Task.CompletedTask;

    private const double FontSizeStep = 10;
    private const double MaxFontSize = 1000;

    private Task AdjustFontSize(int direction)
    {
        if (_textInfo is null) return Task.CompletedTask;
        var size = Math.Clamp(_textInfo.FontSize + direction * FontSizeStep, 1, MaxFontSize);
        if (size == _textInfo.FontSize) return Task.CompletedTask;
        return ChangeTextDraft(nameof(TextInfo.FontSize), size.ToString(
            System.Globalization.CultureInfo.InvariantCulture));
    }

