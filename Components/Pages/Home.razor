        {
            <span class="dev-build">Dev Build @AppInfo.VersionString</span>
        }
    </div>
    @if (!NativeWindow.IsMac)
    {
        <div class="glass win-caption" @onmousedown:stopPropagation @ondblclick:stopPropagation>
            <button type="button" title="Minimise" aria-label="Minimise" @onclick="NativeWindow.Minimize">&#x2212;</button>
            <button type="button" title="Maximise" aria-label="Maximise" @onclick="NativeWindow.ToggleMaximize">&#x25A1;</button>
