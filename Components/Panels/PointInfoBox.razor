<section class="glass process-box" aria-label="Point information" aria-live="polite">
    <div class="process-step">Point information</div>
    <div class="measure-caption">Local point data</div>
    @if (Info.Point is { } point)
    {
        <p class="process-text">X @point.X.ToString("0.###") mm · Y @point.Y.ToString("0.###") mm</p>
        <button type="button" class="chip check-chip @(point.ShowMarker ? "active" : "")" role="checkbox"
                aria-checked="@point.ShowMarker.ToString().ToLowerInvariant()"
                @onclick="() => OnMarkerChanged.InvokeAsync(new(point.Id, !point.ShowMarker))">
            <span class="check-box" aria-hidden="true">@(point.ShowMarker ? "✓" : "")</span>Show marker locally
        </button>
        @if (Info.Visibility != "local")
        {
            <p class="process-text">The project visibility override is active. This local setting is remembered until the override is cleared in File > Project settings.</p>
        }
    }
    else
    {
        <p class="process-text">Click to place a point, or use Select to inspect and move one. Hidden markers remain available for snapping and selection.</p>
    }
</section>

@code {
    public sealed record PointData(int Id, double X, double Y, bool ShowMarker = true);
    public sealed record PointInfo(int Scale, string Visibility, PointData? Point);
    public sealed record SettingsChange(int Scale, string Visibility);
    public sealed record MarkerChange(int Id, bool Show);
    [Parameter, EditorRequired] public PointInfo Info { get; set; } = new(100, "local", null);
    [Parameter] public EventCallback<MarkerChange> OnMarkerChanged { get; set; }
}
